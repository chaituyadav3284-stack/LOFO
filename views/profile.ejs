<%- include('layouts/header') %>

    <div class="container" style="flex-grow: 1; padding: 40px 0;">
        <div class="form-card" style="margin: 0 auto; max-width: 600px;">
            <h2 class="form-title"><i class="fa-solid fa-user-gear"></i> Profile Settings</h2>
            
            <% if (success === 'profile_updated') { %>
                <div class="alert alert-success">
                    <i class="fa-solid fa-circle-check"></i>
                    <span>Profile updated successfully!</span>
                </div>
            <% } %>
            
            <% if (error) { %>
                <div class="alert alert-danger">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    <span>
                        <% if (error === 'fields_required') { %> Name and phone fields are required. <% } %>
                        <% if (error === 'password_mismatch') { %> Passwords do not match. <% } %>
                        <% if (error === 'password_too_short') { %> New password must be at least 6 characters long. <% } %>
                        <% if (error === 'update_failed') { %> Database transaction failed. Please try again. <% } %>
                    </span>
                </div>
            <% } %>

            <% if (dbOffline) { %>
                <div class="alert alert-warning">
                    <i class="fa-solid fa-database"></i>
                    <span>Database connection is offline. Details cannot be edited.</span>
                </div>
            <% } else if (userDetail) { %>
                <form action="/profile" method="POST">
                    <div class="form-group">
                        <label for="email">Email Address (Read-only)</label>
                        <input type="email" id="email" class="form-control" value="<%= userDetail.email %>" readonly style="background-color: #f1f5f9; cursor: not-allowed; color: var(--text-muted);">
                    </div>

                    <div class="form-group">
                        <label for="name">Full Name</label>
                        <input type="text" name="name" id="name" class="form-control" value="<%= userDetail.name %>" required>
                    </div>

                    <div class="form-group">
                        <label for="phone">Phone Number</label>
                        <input type="tel" name="phone" id="phone" class="form-control" value="<%= userDetail.phone %>" pattern="[0-9+ ]{10,15}" required>
                    </div>

                    <hr style="margin: 30px 0; border: 0; border-top: 1px solid var(--border);">
                    <p style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 15px;"><i class="fa-solid fa-circle-info"></i> Leave password fields empty if you do not wish to update your password.</p>

                    <div class="form-group">
                        <label for="password">New Password</label>
                        <input type="password" name="password" id="password" class="form-control" placeholder="Enter new password" minlength="6">
                    </div>

                    <div class="form-group">
                        <label for="confirm_password">Confirm New Password</label>
                        <input type="password" name="confirm_password" id="confirm_password" class="form-control" placeholder="Re-enter new password" minlength="6">
                    </div>

                    <div style="display: flex; gap: 15px; margin-top: 25px;">
                        <button type="submit" class="btn btn-primary" style="flex: 1;">Save Changes</button>
                        <a href="/dashboard" class="btn btn-secondary" style="flex: 1; text-align: center;">Cancel</a>
                    </div>
                </form>
            <% } %>
        </div>
    </div>

<%- include('layouts/footer') %>

