<%- include('layouts/header') %>

    <div class="container" style="flex-grow: 1; display: flex; align-items: center; justify-content: center;">
        <div class="form-card">
            <h2 class="form-title"><i class="fa-solid fa-right-to-bracket"></i> Login to LOFO</h2>
            
            <% if (error) { %>
                <div class="alert alert-danger">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    <span>
                        <% if (error === 'auth_required') { %>
                            Please log in to view that page or contact details.
                        <% } else { %>
                            <%= error %>
                        <% } %>
                    </span>
                </div>
            <% } %>
            
            <% if (success) { %>
                <div class="alert alert-success">
                    <i class="fa-solid fa-circle-check"></i>
                    <span>
                        <% if (success === 'registered') { %>
                            Registration successful! Please log in below.
                        <% } else { %>
                            <%= success %>
                        <% } %>
                    </span>
                </div>
            <% } %>
            
            <form action="/login" method="POST">
                <div class="form-group">
                    <label for="email">Email Address</label>
                    <input type="email" name="email" id="email" class="form-control" placeholder="Enter your email" required>
                </div>
                
                <div class="form-group">
                    <label for="password">Password</label>
                    <input type="password" name="password" id="password" class="form-control" placeholder="Enter password" required>
                </div>
                
                <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 10px;">Login</button>
            </form>
            
            <div class="form-footer">
                <p>Don't have an account? <a href="/register">Register here</a></p>
                <p style="margin-top: 10px;"><a href="/forgot-password">Forgot Password?</a></p>
            </div>
        </div>
    </div>

<%- include('layouts/footer') %>

