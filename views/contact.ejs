<%- include('layouts/header') %>

    <div class="container" style="flex-grow: 1; padding: 40px 0; max-width: 700px;">
        <div class="form-card" style="margin: 0 auto; max-width: 100%; padding: 40px;">
            
            <h2 style="font-size: 2rem; font-weight: 700; color: var(--text-dark); margin-bottom: 10px; display: flex; align-items: center; gap: 10px;">
                <i class="fa-solid fa-envelope-open-text" style="color: var(--primary);"></i>
                Contact Portal Support
            </h2>
            <p style="color: var(--text-muted); margin-bottom: 30px;">Have queries about a listing, account issue, or false claims? Feel free to contact the campus help desk.</p>
            
            <div style="display: flex; flex-direction: column; gap: 20px; margin-bottom: 40px;">
                <div style="display: flex; gap: 15px; border-bottom: 1px solid var(--border); padding-bottom: 15px;">
                    <div style="font-size: 1.5rem; color: var(--primary);"><i class="fa-solid fa-map-location-dot"></i></div>
                    <div>
                        <h4 style="font-weight: 600; color: var(--text-dark);">Office Location</h4>
                        <p style="color: var(--text-muted); font-size: 0.9rem;">Student Activity Centre (SAC), Ground Floor, Desk 04</p>
                    </div>
                </div>
                
                <div style="display: flex; gap: 15px; border-bottom: 1px solid var(--border); padding-bottom: 15px;">
                    <div style="font-size: 1.5rem; color: var(--primary);"><i class="fa-solid fa-clock"></i></div>
                    <div>
                        <h4 style="font-weight: 600; color: var(--text-dark);">Working Hours</h4>
                        <p style="color: var(--text-muted); font-size: 0.9rem;">Monday to Friday: 9:00 AM - 5:00 PM</p>
                    </div>
                </div>

                <div style="display: flex; gap: 15px;">
                    <div style="font-size: 1.5rem; color: var(--primary);"><i class="fa-solid fa-paper-plane"></i></div>
                    <div>
                        <h4 style="font-weight: 600; color: var(--text-dark);">Email & Hotline</h4>
                        <p style="color: var(--text-muted); font-size: 0.9rem;">
                            Email: <strong>support@lofo.edu</strong><br>
                            Phone: <strong>+1 (555) 019-2834</strong>
                        </p>
                    </div>
                </div>
            </div>
            
            <div style="text-align: center;">
                <a href="/" class="btn btn-primary"><i class="fa-solid fa-house"></i> Back to Homepage</a>
            </div>
        </div>
    </div>

<%- include('layouts/footer') %>

