<%- include('layouts/header') %>

    <div class="container" style="flex-grow: 1; display: flex; align-items: center; justify-content: center; padding: 40px 0;">
        <div class="form-card" style="border-top: 4px solid var(--primary); max-width: 450px;">
            <h2 class="form-title" style="text-align: center; margin-bottom: 5px;">Admin Login</h2>
            <p style="text-align: center; color: var(--text-muted); font-size: 0.85rem; margin-bottom: 25px;">Enter credentials to access administrative dashboard.</p>
            
            <% if (error) { %>
                <div class="alert alert-danger">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    <span><%= error %></span>
                </div>
            <% } %>
            
            <form action="/admin-login.php" method="POST">
                <div class="form-group">
                    <label for="username"><i class="fa-solid fa-user-shield"></i> Username</label>
                    <input type="text" name="username" id="username" class="form-control" placeholder="Admin username" required>
                </div>
                
                <div class="form-group">
                    <label for="password"><i class="fa-solid fa-lock"></i> Password</label>
                    <input type="password" name="password" id="password" class="form-control" placeholder="Admin password" required>
                </div>
                
                <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 10px;">
                    <i class="fa-solid fa-shield"></i> Admin Access
                </button>
            </form>
            
            <div class="form-footer" style="margin-top: 25px; text-align: left; background: white; border: 1px solid var(--border); padding: 12px; border-radius: var(--radius);">
                <p style="font-size: 0.75rem; color: var(--text-muted); line-height: 1.4;">
                    <strong>Default Demo Settings:</strong><br>
                    Username: <code>admin</code><br>
                    Password: <code>admin123</code>
                </p>
            </div>
        </div>
    </div>

<%- include('layouts/footer') %>

