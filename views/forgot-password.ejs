<%- include('layouts/header') %>

    <div class="container" style="flex-grow: 1; display: flex; align-items: center; justify-content: center;">
        <div class="form-card" style="max-width: 550px;">
            <h2 class="form-title"><i class="fa-solid fa-key"></i> Reset Password</h2>
            
            <% if (error) { %>
                <div class="alert alert-danger">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    <span><%= error %></span>
                </div>
            <% } %>
            
            <% if (success) { %>
                <div class="alert alert-success">
                    <i class="fa-solid fa-circle-check"></i>
                    <span><%= success %></span>
                </div>
            <% } %>
            
            <form action="/forgot-password" method="POST">
                <div class="form-group">
                    <label for="email">Verify Account Email</label>
                    <input type="email" name="email" id="email" class="form-control" placeholder="Enter registered email" required>
                </div>
                
                <div class="form-group">
                    <label for="phone">Verify Phone Number</label>
                    <input type="tel" name="phone" id="phone" class="form-control" placeholder="Enter registered phone" required>
                </div>
                
                <hr style="margin: 20px 0; border: 0; border-top: 1px solid var(--border);">
                
                <div class="form-group">
                    <label for="new_password">New Password</label>
                    <input type="password" name="new_password" id="new_password" class="form-control" placeholder="Minimum 6 characters" minlength="6" required>
                </div>
                
                <div class="form-group">
                    <label for="confirm_password">Confirm New Password</label>
                    <input type="password" name="confirm_password" id="confirm_password" class="form-control" placeholder="Confirm new password" minlength="6" required>
                </div>
                
                <button type="submit" class="btn btn-primary" style="width: 100%;">Update Password</button>
            </form>
            
            <div class="form-footer">
                <p><a href="/login"><i class="fa-solid fa-arrow-left"></i> Back to Login</a></p>
            </div>
        </div>
    </div>

<%- include('layouts/footer') %>

